#!/bin/sh
brew bundle --file=- <<EOF

# Utilities
brew "azure-cli"
brew "cmake"
brew "ffmpeg"
brew "graphviz"
brew "grpcurl"
brew "jq"
brew "lame"
brew "media-info"
brew "mas"
brew "mr"
brew "mvn"
brew "openssl"
brew "wget"
brew "xz"
brew "z"
brew "zoxide"
brew "zsh-completions"

# Terminal multiplexer (tmux is also in the base mac script)
brew "tmux"
brew "tmuxinator"

# Build tools
brew "ant"
brew "maven"

# Local LLMs
brew "ollama", restart_service: :changed

# Data stores
#brew "mysql"

cask_args appdir: '/Applications'
cask "1password"
cask "1password-cli"
cask "brave-browser"
cask "granola"
cask "claude"
cask "obsidian"
cask "blender"
cask "firefox"
cask "flycut"
cask "google-chrome"
cask "iterm2"
cask "orbstack"
cask "karabiner-elements"
cask "hammerspoon"
cask "notion"
#cask "postico"
cask "postgres-app"
cask "screenflow"
cask "vagrant"
cask "vlc"
cask "zoom"

#App store apps
mas 'DaisyDisk', id: 411643860
mas 'Haskell', id: 841285201
mas 'OmniGraffle', id: 1142578753 
mas 'Slack', id: 803453959
mas 'The Unarchiver', id: 425424353
mas 'WhatsApp', id: 310633997
mas '1Password for Safari', id: 1569813296
mas 'Chordio', id: 1580214821
mas 'Dropover', id: 1355679052
mas 'forScore', id: 363738376
mas 'Kindle', id: 302584613
mas 'Logic Pro', id: 634148309
mas 'MindNode Classic', id: 1289197285
mas 'Xcode', id: 497799835
EOF

fancy_echo "Installing language runtimes via mise ..."
KERL_CONFIGURE_OPTIONS="--without-javac --with-ssl=$(brew --prefix openssl@3)"
export KERL_CONFIGURE_OPTIONS
mise use --global \
  clojure@latest erlang@latest elixir@latest go@latest gradle@latest \
  haxe@latest java@latest kubectl@latest leiningen@latest \
  mysql@latest python@latest terraform@latest

# --- Personal environment setup (Claude Code, Starship, fonts, iTerm, clean zsh) ---
# Use LAPTOP_DIR exported by the mac script (the cloned repo); fall back to the
# directory of whatever sourced this file.
repo_dir="${LAPTOP_DIR:-$(cd "$(dirname "$0")" && pwd)}"
if [ -f "$repo_dir/setup/install.sh" ]; then
  sh "$repo_dir/setup/install.sh"
else
  fancy_echo "Skipping personal setup: $repo_dir/setup/install.sh not found"
fi
