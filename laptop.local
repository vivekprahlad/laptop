#!/bin/sh
brew bundle --file=- <<EOF

# Utilities
brew "azure-cli"
brew "cmake"
brew "ffmpeg"
brew "graphviz"
brew "grpcurl"
brew "hyperkit"
brew "jq"
brew "lame"
brew "media-info"
brew "mas"
brew "mr"
brew "mvn"
brew "openssl"
brew "wget"
brew "youtube-dl"
brew "xz"
brew "z"
brew "zoxide"
brew "zsh-completions"

# Terminal multiplexer (tmux is also in the base mac script)
brew "tmux"
brew "tmuxinator"

# Build tools
brew "ant"
brew "maven"

# Data stores
#brew "mysql"

cask_args appdir: '/Applications'
cask "1password"
cask "1password-cli"
cask "adobe-acrobat-reader"
cask "blender"
cask "virtualbox"
#cask "firefox"
cask "flycut"
#cask "google-chrome"
cask "iterm2"
cask "karabiner-elements"
#cask "notion"
cask "postico"
cask "postgres"
cask "screenflow"
cask "vagrant"
cask "vlc"
#cask "zoom"

#App store apps
mas 'DaisyDisk', id: 411643860
mas 'Haskell', id: 841285201
mas 'iBooks Author', id: 490152466
mas 'OmniGraffle', id: 1142578753 
mas 'Slack', id: 803453959
mas 'The Unarchiver', id: 425424353
mas 'WhatsApp', id: 1147396723
EOF


fancy_echo "Installing language runtimes via mise ..."
KERL_CONFIGURE_OPTIONS="--without-javac --with-ssl=$(brew --prefix openssl@3)"
export KERL_CONFIGURE_OPTIONS
mise use --global \
  clojure@latest erlang@latest elixir@latest go@latest gradle@latest \
  ghc@latest haxe@latest java@latest kubectl@latest leiningen@latest \
  mysql@latest python@latest terraform@latest

brew uninstall postgresql@14
brew uninstall redis

# --- Personal environment setup (Claude Code, Starship, fonts, iTerm, clean zsh) ---
# Locate this repo via the ~/.laptop.local symlink, then run setup/install.sh.
laptop_local="$HOME/.laptop.local"
if [ -L "$laptop_local" ]; then
  repo_dir="$(cd "$(dirname "$(readlink "$laptop_local")")" && pwd)"
else
  repo_dir="$(cd "$(dirname "$laptop_local")" && pwd)"
fi
if [ -f "$repo_dir/setup/install.sh" ]; then
  sh "$repo_dir/setup/install.sh"
else
  fancy_echo "Skipping personal setup: $repo_dir/setup/install.sh not found"
fi
